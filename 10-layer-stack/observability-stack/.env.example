# Copy to .env and fill in every value before starting the stack.
# Never commit .env — it is gitignored (see .gitignore: *.env).
#
# GRAFANA_ADMIN_PASSWORD is REQUIRED. docker-compose.yml uses
# ${GRAFANA_ADMIN_PASSWORD:?...}, so compose fails at parse time when the
# variable is unset or empty. The value below is deliberately empty: copying
# this file to .env and forgetting to fill it in produces a hard error
# instead of a Grafana running with a placeholder password.
#
# Generate one:
#   printf 'GRAFANA_ADMIN_PASSWORD=%s\n' "$(openssl rand -hex 16)" >> .env
#
# Grafana applies the admin password only when it initialises its database.
# If grafana_data already exists, a changed .env value is ignored — see
# TROUBLESHOOTING.md.

# Admin account name. Not a secret; the default is fine.
GRAFANA_ADMIN_USER=admin

# Admin password. REQUIRED — must be a real secret, not a placeholder.
GRAFANA_ADMIN_PASSWORD=
